NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# AI features (voice quotes, AI notes). Create a key at vercel.com > AI Gateway > API keys.
AI_GATEWAY_API_KEY=
# Daily automatic reminders job. Any long random text. Set the same value in Vercel.
CRON_SECRET=
# Tender hub: the daily job needs the service role key (server only, never NEXT_PUBLIC_) and the CRON_SECRET above.
SUPABASE_SERVICE_ROLE_KEY=
# Optional. Only set this if National Treasury changes the eTenders address.
ETENDERS_API_URL=
